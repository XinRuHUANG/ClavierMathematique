        "Logique" to listOf(
            "∀", "∃", "∄", "¬", "∧", "∨", "⇒", "⇔", "⟹", "⟺",
            "⊤", "⊥", "∴", "∵", "⊢", "⊨", "⊻", "⊼", "⊽", "∎",
            "⊣", "⊩", "⊬", "⊭", "⊮", "⊯", "∦", "∥", "≃", "≡"
