        "Algèbre linéaire" to listOf(
            "→", "·", "×", "⊗", "⊕", "⟨", "⟩", "‖", "det", "tr",
            "ker", "Im", "dim", "span", "Aᵀ", "A⁻¹", "Iₙ", "λ", "v⃗", "u⃗",
            "0⃗", "ℝⁿ", "Id", "rank", "diag", "A²", "Aᵀ", "A⁻¹", "⟶", "↦"
