            "Σ", "Ω", "ℯ", "ϕ", "ϵ", "ς"
        ),
        "Ensembles" to listOf(
            "∈", "∉", "∋", "⊂", "⊆", "⊃", "⊇", "∪", "∩", "∅",
            "∖", "⊄", "⊈", "ℕ", "ℤ", "ℚ", "ℝ", "ℂ", "𝔽", "⊕",
            "⊗", "∁", "⊊", "⊋", "⊍", "⊎", "∃", "∀", "∉", "∋"
        ),
        "Analyse" to listOf(
            "lim", "→", "∞", "∑", "∏", "∫", "∬", "∮", "∂", "∇",
            "′", "″", "Δ", "d/dx", "dx", "dy", "∯", "∰", "∴", "∵",
            "↦", "⟶", "∄", "∃", "∂x", "∂y", "∂²", "∮", "∫", "∬"
