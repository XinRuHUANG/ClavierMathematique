<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Autorisation nécessaire pour afficher le panneau flottant -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:label="Clavier Mathématique"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".FloatingMathService"
            android:exported="false" />

        <service
            android:name=".MathAccessibilityService"
            android:label="Insertion de symboles mathématiques"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/math_accessibility_service" />
        </service>

    </application>

</manifest>